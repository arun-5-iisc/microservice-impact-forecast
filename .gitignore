# Python
__pycache__/
*.py[cod]
venv/
.venv/
.env
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Raw telemetry (about 20 GB). Shared separately, see "Data" in README.md.
dataset/raw/
# span cache, rebuilt by ./scripts/run_genai_eval.sh prepare
dataset/spans/

# LLM runs: only each run's results.csv is pushed
results/genai/holdout/*/*/*/
results/genai/sensitivity/*/*/*/
results/genai/dev/*/*/
# live-mode records and their telemetry snapshots
results/genai/live/
# caches of the label analyses, rebuilt from the raw data
results/reliability/*/cache.pkl
results/reliability/*/stats.pkl

# trained models: only the final pair and the RAG index are pushed; the other model files are
# intermediate outputs that scripts/run_pipeline.sh rebuilds
models/*
!models/fe_tuned/
!models/rag_index/

# run logs
logs/
*.log
